#!/usr/bin/env python3
"""Manda uma resposta do Chefe Geral ao Guilherme no Telegram (@Chefegui_bot). Só biblioteca padrão.

Uso:
  cg-telegram-responder --pedido-id tg5 --titulo "Pauta Skylo" < resposta.txt
  cg-telegram-responder --pedido-id tg5 --titulo "Pauta Skylo" --arquivo resposta.md

- Destino FIXO: o chat_id do próprio Guilherme em ~/.config/chefegeral/telegram.json. Não há opção para outro chat.
- Token: só da variável de ambiente TELEGRAM_BOT_TOKEN. Nunca é impresso nem gravado.
- Texto puro (sem parse_mode). Até 4096 caracteres vai como mensagem; acima disso vai como documento .md.
- Toda mensagem leva o cabeçalho "Chefe Geral, resposta ao pedido <id>" e o botão "Guardando no Obsidian":
  a ponte do Mac encontra essas mensagens, grava em "Chefe Geral/Respostas" e troca o botão para "No Obsidian".
- Nuvem (opcional): se ~/.config/chefegeral/nuvem.json tiver {"url", "token"} (token de resposta do Worker),
  depois de enviar ao Telegram também grava a resposta na ponte na nuvem (POST /resposta). Falha ali não muda
  o resultado do envio. Sem o arquivo, ou com --sem-nuvem, o comportamento é o mesmo de antes.
- Saída: uma linha JSON {ok, modo, message_id} ou {ok:false, erro}. Código 0 em sucesso.
"""
import argparse, json, os, re, sys, urllib.error, urllib.parse, urllib.request, uuid

CFG = os.path.expanduser("~/.config/chefegeral/telegram.json")
NUVEM = os.path.expanduser("~/.config/chefegeral/nuvem.json")
LIMITE = 4096
PREFIXO = "Chefe Geral, resposta ao pedido "
HUB = "https://guilh-abc.github.io/chefe-geral-hub/#/arquivo"
BOTAO = json.dumps({"inline_keyboard": [[{"text": "Guardando no Obsidian…", "url": HUB}]]}, ensure_ascii=False)


def tam(s):  # o Telegram conta em unidades UTF-16
    return len(s.encode("utf-16-le")) // 2


def limpar(s):
    return re.sub(r"bot\d+:[\w-]+", "bot<token>", str(s))


def chamar(token, metodo, dados=None, multipart=None):
    url = f"https://api.telegram.org/bot{token}/{metodo}"
    if multipart:
        corpo, ctype = multipart
        req = urllib.request.Request(url, data=corpo, headers={"Content-Type": ctype})
    else:
        req = urllib.request.Request(url, data=urllib.parse.urlencode(dados or {}).encode())
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            j = json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        try:
            j = json.loads(e.read().decode("utf-8"))
        except Exception:
            j = {"ok": False, "description": f"HTTP {e.code}"}
    if not j.get("ok"):
        raise RuntimeError(j.get("description", "erro"))
    return j["result"]


def multipart(campos, nome_arq, conteudo):
    b = "----cg" + uuid.uuid4().hex
    partes = []
    for k, v in campos.items():
        partes.append(f'--{b}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode("utf-8"))
    partes.append(f'--{b}\r\nContent-Disposition: form-data; name="document"; filename="{nome_arq}"\r\nContent-Type: text/markdown; charset=utf-8\r\n\r\n'.encode("utf-8"))
    partes.append(conteudo.encode("utf-8") + b"\r\n")
    partes.append(f"--{b}--\r\n".encode())
    return b"".join(partes), f"multipart/form-data; boundary={b}"


def para_nuvem(pid, titulo, texto, message_id):
    """Grava a resposta no Worker. Retorna "ok", "sem_config" ou "erro: ..."; nunca levanta exceção."""
    try:
        n = json.load(open(NUVEM, encoding="utf-8"))
        url, tok = (n.get("url") or "").rstrip("/"), (n.get("token") or "").strip()
    except Exception:
        return "sem_config"
    if not (url.startswith("https://") and tok):
        return "sem_config"
    try:
        corpo = json.dumps({"pedido_id": pid, "titulo": titulo, "texto": texto, "message_id": message_id}).encode("utf-8")
        req = urllib.request.Request(url + "/resposta", data=corpo, headers={"Content-Type": "application/json", "Authorization": "Bearer " + tok, "User-Agent": "ChefeGeral-Box/1.0"})  # Cloudflare 1010 bloqueia Python-urllib
        with urllib.request.urlopen(req, timeout=20) as r:
            return "ok" if 200 <= r.status < 300 else f"erro: HTTP {r.status}"
    except Exception as e:
        return "erro: " + limpar(e).replace(tok, "<token>")[:120]


def main():
    ap = argparse.ArgumentParser(description="Resposta do Chefe Geral para o Telegram do Guilherme")
    ap.add_argument("--pedido-id", required=True)
    ap.add_argument("--titulo", default="")
    ap.add_argument("--arquivo", help="arquivo com o texto (senão, lê do stdin)")
    ap.add_argument("--sem-nuvem", action="store_true", help="não grava a resposta na ponte na nuvem")
    ap.add_argument("--dry-run", action="store_true", help="não envia, só mostra o modo e o tamanho")
    a = ap.parse_args()

    pid = re.sub(r"\s+", "-", a.pedido_id.strip())[:64] or "sem-id"
    titulo = re.sub(r"\s+", " ", a.titulo).strip()[:120]
    texto = open(a.arquivo, encoding="utf-8").read() if a.arquivo else sys.stdin.read()
    texto = texto.strip()
    if not texto:
        print(json.dumps({"ok": False, "erro": "texto vazio"}, ensure_ascii=False)); return 2

    try:
        chat_id = str(json.load(open(CFG, encoding="utf-8"))["chat_id"]).strip()
    except Exception:
        print(json.dumps({"ok": False, "erro": f"chat_id ausente em {CFG}"}, ensure_ascii=False)); return 2
    token = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
    if not token and not a.dry_run:
        print(json.dumps({"ok": False, "erro": "TELEGRAM_BOT_TOKEN ausente"}, ensure_ascii=False)); return 2

    cab = PREFIXO + pid + (f": {titulo}" if titulo else "")
    msg = f"{cab}\n\n{texto}"
    modo = "mensagem" if tam(msg) <= LIMITE else "documento"
    if a.dry_run:
        print(json.dumps({"ok": True, "modo": modo, "caracteres": tam(msg), "dry_run": True}, ensure_ascii=False)); return 0
    try:
        if modo == "mensagem":
            r = chamar(token, "sendMessage", {"chat_id": chat_id, "text": msg, "reply_markup": BOTAO,
                                              "link_preview_options": json.dumps({"is_disabled": True})})
        else:
            previa = texto[:600].rstrip()
            legenda = f"{cab}\n\nResposta longa ({tam(texto)} caracteres): o texto completo está no arquivo.\n\n{previa}…"
            while tam(legenda) > 1024:
                previa = previa[:-50]
                legenda = f"{cab}\n\nResposta longa ({tam(texto)} caracteres): o texto completo está no arquivo.\n\n{previa}…"
            nome = re.sub(r"[^\w.-]", "_", f"resposta-{pid}.md")
            corpo = f"{cab}\n\n# {titulo or 'Resposta ' + pid}\n\n{texto}\n"
            r = chamar(token, "sendDocument", multipart=multipart({"chat_id": chat_id, "caption": legenda, "reply_markup": BOTAO}, nome, corpo))
        saida = {"ok": True, "modo": modo, "message_id": r.get("message_id")}
        if not a.sem_nuvem:
            nv = para_nuvem(pid, titulo, texto, r.get("message_id"))
            if nv != "sem_config":
                saida["nuvem"] = nv
        print(json.dumps(saida, ensure_ascii=False))
        return 0
    except Exception as e:
        print(json.dumps({"ok": False, "erro": limpar(e)[:300]}, ensure_ascii=False)); return 1


if __name__ == "__main__":
    sys.exit(main())
